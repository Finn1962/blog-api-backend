generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AUTHOR
}

enum Status {
  DRAFT
  PUBLIC
}

model User {
  id                 Int             @id @default(autoincrement())
  email              String          @unique
  password_hash      String
  username           String         @unique
  created_at         DateTime       @default(now())
  role               Role           @default(USER)
  blogs              Post[]
  comments           Comment[]
  refresh_token      Refresh_Token?
}

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  content     String
  author      User      @relation(fields: [author_id], references: [id])
  author_id   Int
  status      Status    @default(DRAFT)
  created_at  DateTime  @default(now())
  comments    Comment[]
  tags        Tag[]
  image_path  String? 
}

model Tag {
  id        Int       @id @default(autoincrement())
  content   String
  post      Post      @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id   Int
}

model Comment {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  blog        Post     @relation(fields: [post_id], references: [id])
  post_id     Int
  author      User     @relation(fields: [author_id], references: [id])
  author_id   Int
  created_at  DateTime @default(now())
}

model Refresh_Token {
  id         Int        @id @default(autoincrement())
  token      String
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    Int        @unique
  created_at DateTime   @default(now())
}