generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AUTHOR
  ADMIN
}

enum Status {
  DRAFT
  PUBLIC
}

enum PROG_LANG {
  JAVA_SCRIPT
  HTML
  CSS
  TYPE_SCRIPT
  PYTHON
  SQL
  GO
  RUBY
  RUST
  PHP
  JAVA
  C
  C_PLUS_PLUS
  C_SHARP
}

model User {
  id                  Int             @id @default(autoincrement())
  email               String          @unique
  password_hash       String
  username            String         @unique
  created_at          DateTime       @default(now())
  role                Role           @default(USER)
  profile_image_path  String?        
  email_notifications Boolean        @default(false)
  blogs               Post[]
  comments            Comment[]
  refresh_token       Refresh_Token?
}

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  content     String
  prog_lang   PROG_LANG @default(JAVA_SCRIPT)
  author      User      @relation(fields: [author_id], references: [id])
  author_id   Int
  status      Status    @default(DRAFT)
  created_at  DateTime  @default(now())
  comments    Comment[]
  tags        Tag[]
  image_path  String? 
}

model Tag {
  id        Int       @id @default(autoincrement())
  content   String
  post      Post      @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id   Int
}

model Comment {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  blog        Post     @relation(fields: [post_id], references: [id])
  post_id     Int
  author      User     @relation(fields: [author_id], references: [id])
  author_id   Int
  created_at  DateTime @default(now())
}

model Refresh_Token {
  id         Int        @id @default(autoincrement())
  token      String
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    Int        @unique
  created_at DateTime   @default(now())
}